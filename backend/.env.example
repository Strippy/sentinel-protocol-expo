# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── API Security ──────────────────────────────────────────────────────────────
# Shared secret sent as X-Sentinel-API-Key header from mobile app
API_KEY=your_api_key_here

# Admin dashboard secret (replace with JWT in production)
ADMIN_SECRET=your_admin_secret_here

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=sentinel-invoices
KMS_KEY_ARN=arn:aws:kms:ap-southeast-2:...

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=invoices@sentinelprotocol.app
SMTP_PASS=your_smtp_password

INVOICE_FROM_NAME=Sentinel Data Pty Ltd
INVOICE_FROM_EMAIL=invoices@sentinelprotocol.app

# ── Business / Invoice ────────────────────────────────────────────────────────
SUPPLIER_ABN=51824753556
SUPPLIER_NAME=Sentinel Data Pty Ltd

# ── Tax ───────────────────────────────────────────────────────────────────────
GST_RATE=0.10
COMMISSION_RATE=0.15
